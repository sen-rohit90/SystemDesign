        <mxCell id="0gBvA5zlPccnvj9Yevd9-104" parent="1" style="text;strokeColor=#666666;align=center;fillColor=#f5f5f5;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#333333;" value="Design a OTP System" vertex="1">
          <mxGeometry height="30" width="170" x="522.3863541679345" y="3850" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-105" parent="1" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="1. Functional Requirement&lt;br&gt;2. Non-functional requirements" vertex="1">
          <mxGeometry height="70" width="120" x="262.3863541679345" y="3940" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-106" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;rotation=-5;" value="Step 1" vertex="1">
          <mxGeometry height="60" width="120" x="82.38635416793448" y="3940" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-107" parent="1" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="Functional&lt;br&gt;-&amp;nbsp;Generate OTPs securely.&lt;div&gt;- Send OTPs to users via a preferred channel (e.g., SMS, email, or mobile app).&lt;/div&gt;&lt;div&gt;- Validate OTPs provided by users.&lt;/div&gt;&lt;div&gt;- Implement security features to prevent misuse or fraud.&lt;/div&gt;&lt;div&gt;- Allow OTP expiration and single-use functionality.&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="180" x="462.3863541679345" y="3940" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-108" parent="1" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="Non-Functional&lt;br&gt;-&amp;nbsp;Security: High security standards to prevent unauthorized access.&lt;div&gt;- Scalability: The system should handle a large number of requests.&lt;/div&gt;&lt;div&gt;- Availability: Ensure system availability to prevent service disruptions.&lt;/div&gt;&lt;div&gt;- Performance: Generate and validate OTPs with minimal latency.&lt;/div&gt;&lt;div&gt;- Compliance: Comply with data protection and privacy regulations.&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="180" x="682.3863541679345" y="3940" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-109" parent="1" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="3 Explore what API&#39;s the system would need" vertex="1">
          <mxGeometry height="70" width="120" x="272.3863541679345" y="4300" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-110" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;rotation=-5;" value="Step 2" vertex="1">
          <mxGeometry height="60" width="120" x="92.38635416793448" y="4320" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-111" parent="1" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;div&gt;- Generate OTP API: To create and send OTPs to users.&lt;/div&gt;&lt;div&gt;- Validate OTP API: To verify OTPs provided by users.&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="230" x="272.3863541679345" y="4400" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-112" parent="1" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="4 Touch base on the data schema to arrive at which DB to use?" vertex="1">
          <mxGeometry height="70" width="120" x="282.3863541679345" y="4590" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-113" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;rotation=-5;" value="Step 3" vertex="1">
          <mxGeometry height="60" width="120" x="92.38635416793448" y="4600" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-114" parent="1" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;div&gt;1. Users Table:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;This table stores information about registered users.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;users&lt;/div&gt;&lt;div&gt;+----+-----------+------------+&lt;/div&gt;&lt;div&gt;| ID | Username&amp;nbsp; | Other Data |&lt;/div&gt;&lt;div&gt;+----+-----------+------------+&lt;/div&gt;&lt;div&gt;| 1&amp;nbsp; | user123&amp;nbsp; &amp;nbsp;| ...&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; |&lt;/div&gt;&lt;div&gt;| 2&amp;nbsp; | user456&amp;nbsp; &amp;nbsp;| ...&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; |&lt;/div&gt;&lt;div&gt;+----+-----------+------------+&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="590" x="122.38635416793448" y="4840" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-115" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;div style=&quot;border-color: var(--border-color); text-align: left;&quot;&gt;2. OTPs Table:&lt;br style=&quot;border-color: var(--border-color);&quot;&gt;&lt;/div&gt;&lt;div style=&quot;border-color: var(--border-color); text-align: left;&quot;&gt;&lt;br style=&quot;border-color: var(--border-color);&quot;&gt;&lt;/div&gt;&lt;div style=&quot;border-color: var(--border-color); text-align: left;&quot;&gt;This table stores generated OTPs and their associated metadata.&lt;/div&gt;&lt;div style=&quot;border-color: var(--border-color); text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;border-color: var(--border-color); text-align: left;&quot;&gt;otps&lt;/div&gt;&lt;div style=&quot;border-color: var(--border-color); text-align: left;&quot;&gt;+----+---------+--------------+---------------------+---------------------+&lt;/div&gt;&lt;div style=&quot;border-color: var(--border-color); text-align: left;&quot;&gt;| ID | User_ID | OTP&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; | Expiration_Time&amp;nbsp; &amp;nbsp; &amp;nbsp;| Created_Time&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; |&lt;/div&gt;&lt;div style=&quot;border-color: var(--border-color); text-align: left;&quot;&gt;+----+---------+--------------+---------------------+---------------------+&lt;/div&gt;&lt;div style=&quot;border-color: var(--border-color); text-align: left;&quot;&gt;| 1&amp;nbsp; | 1&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;| 123456&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;| 2023-09-07 12:00:00 | 2023-09-07 11:55:00 |&lt;/div&gt;&lt;div style=&quot;border-color: var(--border-color); text-align: left;&quot;&gt;| 2&amp;nbsp; | 2&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;| 987654&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;| 2023-09-07 12:15:00 | 2023-09-07 12:10:00 |&lt;/div&gt;&lt;div style=&quot;border-color: var(--border-color); text-align: left;&quot;&gt;+----+---------+--------------+---------------------+---------------------+&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="430" x="492.3863541679345" y="4850" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-116" parent="1" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;div&gt;3. User-Specific Data Table:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;If your application requires additional user-specific data, you may have a table for it.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;user_data&lt;/div&gt;&lt;div&gt;+----+---------+--------------+&lt;/div&gt;&lt;div&gt;| ID | User_ID | Data&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;|&lt;/div&gt;&lt;div&gt;+----+---------+--------------+&lt;/div&gt;&lt;div&gt;| 1&amp;nbsp; | 1&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;| ...&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; |&lt;/div&gt;&lt;div&gt;| 2&amp;nbsp; | 2&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;| ...&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; |&lt;/div&gt;&lt;div&gt;+----+---------+--------------+&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="440" x="972.3863541679345" y="4850" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-117" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="522.3863541679345" y="5010" as="sourcePoint" />
            <mxPoint x="562.3863541679345" y="4950" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-118" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="Index USer_ID for faster retreval" vertex="1">
          <mxGeometry height="30" width="120" x="462.3863541679345" y="5010" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-119" parent="1" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="Implement logic to clean up expired OTPs from the &quot;otps&quot; table regularly to prevent unnecessary database growth." vertex="1">
          <mxGeometry height="30" width="240" x="652.3863541679345" y="5010" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-120" edge="1" parent="1" style="endArrow=none;html=1;rounded=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="732.3863541679345" y="4990" as="sourcePoint" />
            <mxPoint x="722.3863541679345" y="4960" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-121" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;rotation=-5;" value="Step 4" vertex="1">
          <mxGeometry height="60" width="120" x="122.38635416793448" y="5290" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-122" parent="1" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="4 arrive at which DB to use?&lt;br&gt;- Use a relational database (e.g., PostgreSQL, MySQL) or NoSQL database (e.g., MongoDB) to store user data, OTPs, and related information. The choice depends on your specific needs and &lt;b&gt;scalability &lt;/b&gt;requirements.&lt;br&gt;-&amp;nbsp;Optimize the database for read-heavy operations, as OTP validation is frequent.&lt;div&gt;- Use indexing for fast retrieval of OTP records.&lt;/div&gt;&lt;div&gt;- Implement caching mechanisms (e.g., Redis) to reduce database load.&lt;/div&gt;&lt;div&gt;- Periodically clean up expired OTP records to manage database size.&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="280" x="302.3863541679345" y="5280" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-123" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;rotation=-5;" value="Step 5" vertex="1">
          <mxGeometry height="60" width="120" x="132.38635416793448" y="5660" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-124" parent="1" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="Assess Traffic Load&lt;br&gt;- How many users?&lt;br&gt;- How may OTP generations per minute?&lt;br&gt;This will let you know to use a load balanced OTP generation to balance traffic" vertex="1">
          <mxGeometry height="100" width="180" x="332.3863541679345" y="5670" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-125" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;rotation=-5;" value="Step 6" vertex="1">
          <mxGeometry height="60" width="120" x="142.38635416793448" y="5910" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-126" parent="1" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="Identify network protocols&lt;br&gt;- HTTPS for transferring OTP through the network&lt;br&gt;- SMTP to send SMS&#39;s" vertex="1">
          <mxGeometry height="100" width="180" x="342.3863541679345" y="5920" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-127" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;rotation=-5;" value="Step 6" vertex="1">
          <mxGeometry height="60" width="120" x="152.38635416793448" y="6110" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-128" parent="1" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="Technical Implementation:&amp;nbsp;&lt;br&gt;-&amp;nbsp;OTP Generation:&lt;div&gt;1. Use a strong random number generator to create OTPs.&lt;/div&gt;&lt;div&gt;2. Set an expiration time for OTPs (e.g., 5 minutes).&lt;/div&gt;&lt;div&gt;3. Store the OTP along with the user&#39;s identifier in the database.&lt;/div&gt;&lt;div&gt;4. Send the OTP to the user&#39;s preferred channel (e.g., email, SMS)&lt;/div&gt;&lt;div&gt;.&lt;/div&gt;&lt;div&gt;OTP Validation:&lt;/div&gt;&lt;div&gt;1. User enters OTP.&lt;/div&gt;&lt;div&gt;2. Retrieve the stored OTP and related information from the database.&lt;/div&gt;&lt;div&gt;3. Check if the OTP matches and hasn&#39;t expired.&lt;/div&gt;&lt;div&gt;4. Invalidate the OTP after successful validation to prevent reuse.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- for SMS Gateway&lt;/div&gt;&lt;div&gt;1. Choose a reliable SMS gateway integration like Twilio - should have error handling and delivery failures options&lt;/div&gt;&lt;div&gt;2. Integrate a message Queue System like Apache Kafka to manage SMS sending asynchronously&lt;/div&gt;&lt;div&gt;3. Ensure Backup and Redundancy by having multiple instances of SMS gateway&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="460" x="352.3863541679345" y="6120" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-129" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;rotation=-5;" value="Step 7" vertex="1">
          <mxGeometry height="60" width="120" x="172.38635416793448" y="6410" as="geometry" />
        </mxCell>
        <mxCell id="0gBvA5zlPccnvj9Yevd9-130" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="Final Diagram" vertex="1">
          <mxGeometry height="30" width="90" x="382.3863541679345" y="6430" as="geometry" />
        </mxCell>
